{
  "name": "koonta-print",
  "version": "0.2.0",
  "description": "Programa de escritorio que imprime comandas de Koonta en impresoras térmicas.",
  "author": "Koonta",
  "private": true,
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "electron-store": "^8.2.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.koonta.print",
    "productName": "Koonta Print",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "renderer/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Koonta Print",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
